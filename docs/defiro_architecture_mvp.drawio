  <diagram id="life" name="Plugin step lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="life-enter" value="&lt;b&gt;enter(step)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;transition arrives here&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="10" y="100" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-dec" value="&lt;b&gt;Wait or Done?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;plugin decides&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="240" y="100" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-task" value="&lt;b&gt;task for people&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;assignee rule → users&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-open" value="&lt;b&gt;open · check data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;as often as needed&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="720" y="20" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-comp" value="&lt;b&gt;complete(decision)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;person acts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="720" y="180" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-out" value="&lt;b&gt;outcome&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#555555&quot;&gt;→ transition → next step&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="950" y="100" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="life-note" value="Starting step: no transition arrives and enter isn&#39;t called. The requester acts on it directly (open · check · complete), with no task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#555555;fontFamily=Helvetica;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="10" y="190" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P1" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="life-enter" target="life-dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P2" value="Wait(assignee rule)" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5833;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="life-dec" target="life-task">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="62.0" y="11.0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P3" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="life-task" target="life-open">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P4" value="submit / decide" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="life-open" target="life-comp">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="53.0" y="0.0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="P5" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.9667;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="life-comp" target="life-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P6" value="Done(outcome, documents) · automatic step, e.g. document generation" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#888888;fontColor=#333333;fontFamily=Helvetica;fontSize=11;labelBackgroundColor=default;exitX=1.0;exitY=0.6667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.6667;entryDx=0;entryDy=0;entryPerimeter=0;jumpStyle=arc;jumpSize=14;" edge="1" parent="1" source="life-dec" target="life-out">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-49.0" y="14.0" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
